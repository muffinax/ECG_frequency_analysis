    "help_window_title": "User Manual and Help",
    "help_window_guide_title": "ECG Application Guide",
    "help_window_close_btn": "I understand, close",
    "help_window_step1_header": "Step 1: Loading a file and Navigation\n",
    "help_window_step1_text1": "To start working, select from the top menu ",
    "help_window_step1_menu_path": "File -> Open",
    "help_window_step1_text2": ". After loading the file, use the bottom panel to move through the signal:\n",
    "help_window_step1_bullet1": "- Jump to the very beginning / end of the recording.\n",
    "help_window_step1_bullet2": "- Jump to the previous / next annotation (according to the selected table on the right side).\n",
    "help_window_step1_bullet3": "- Move the window view left / right.\n",
    "help_window_step1_bullet4": "- Automatic playback (Play) and stopping (Pause) of the signal.\n",
    "help_window_step1_bullet5": "You can also type a specific time in seconds in the field on the right and click 'Go'.\n",
    "help_window_step1_zoom_lbl": "Zooming the chart: ",
    "help_window_step1_zoom_text": "Hold the Ctrl key and use the mouse wheel over the chart to smoothly change its height.\n",
    "help_window_step2_header": "Step 2: View settings (Parameters)\n",
    "help_window_step2_text1": "You can freely change the view range. Select from the menu ",
    "help_window_step2_menu_path": "Analysis -> Parameters",
    "help_window_step2_text2": ":\n",
    "help_window_step2_bullet1_lbl": "• Window size: ",
    "help_window_step2_bullet1_text": "Changes the number of seconds currently displayed on the screen (X-axis).\n",
    "help_window_step2_bullet2_lbl": "• Amplitude: ",
    "help_window_step2_bullet2_text": "Changes the initial vertical chart range (Y-axis).\n",
    "help_window_step3_header": "Step 3: AI Analysis and Annotation Management\n",
    "help_window_step3_text1": "The panel on the right contains two tables that group detected events.\n",
    "help_window_step3_bullet1_lbl": "• Upper table (Saved Annotations): ",
    "help_window_step3_bullet1_text": "Regular markers. Clicking them will draw a red vertical line at the event location and clear FFT spectra.\n",
    "help_window_step3_bullet2_lbl": "• Lower table (AI Annotations): ",
    "help_window_step3_bullet2_text1": "To generate it, use the menu ",
    "help_window_step3_menu_path": "Analysis -> Full File Analysis",
    "help_window_step3_bullet2_text2": ".\n",
    "help_window_step3_fft_lbl": "FFT Preview: ",
    "help_window_step3_fft_text": "Clicking an AI annotation will highlight the signal interval in blue and display the frequency spectrum.\n",
    "help_window_step3_action_lbl": "Action Column: ",
    "help_window_step3_action_text": "In the AI table, by clicking [ ADD ] or [ DELETE ] you decide whether a given result should be kept. Bold text means the annotation is approved.\n",
    "help_window_step3_extra_lbl": "Additional buttons at the bottom of the screen:\n",
    "help_window_step3_edit_lbl": "- Add / Edit: ",
    "help_window_step3_edit_text": "Active after selecting an AI annotation. Allows modification of its type, adding a custom label, and text notes.\n",
    "help_window_step3_bulk_lbl": "- + Add all annotations / - Del all annotations: ",
    "help_window_step3_bulk_text": "Allow quick, bulk approval or rejection of all detected artificial intelligence annotations at once.\n",
    "help_window_step4_header": "Step 4: Saving changes\n",
    "help_window_step4_text1": "To keep the results, select from the top menu ",
    "help_window_step4_menu_save": "File -> Save",
    "help_window_step4_text_or": " or ",
    "help_window_step4_menu_save_as": "Save as",
    "help_window_step4_text2": ".\n",
    "help_window_step4_bullet1": "The saved file will contain all original annotations and ",
    "help_window_step4_bullet2": "only approved AI annotations ",
    "help_window_step4_bullet3": "(those that had the status [ DELETE ] and bold font). Thanks to this mechanism, false or rejected AI findings will not contaminate your output data.\n"
}